<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cartao"
        android:orientation="horizontal"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="92dp">

            <TextView
                android:id="@+id/capaTexto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/capa_vazia"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="5"
                android:padding="4dp"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/capa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tituloLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/texto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/autor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/texto2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/formato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/texto2"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/barraProgresso"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="1000"
                android:progressDrawable="@drawable/progresso" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnFav"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/favorito"
                    android:focusable="false"
                    android:src="@drawable/ic_estrela_vazia" />

                <ImageButton
                    android:id="@+id/btnParaLer"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/marcar_para_ler"
                    android:focusable="false"
                    android:src="@drawable/ic_relogio" />

                <ImageButton
                    android:id="@+id/btnLido"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/marcar_lido"
                    android:focusable="false"
                    android:src="@drawable/ic_lido" />

                <TextView
                    android:id="@+id/porcentagem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/texto2"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnMais"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mais"
                    android:focusable="false"
                    android:src="@drawable/ic_mais"
                    android:tint="@color/texto2" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
