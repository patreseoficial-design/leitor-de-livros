<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/app_name"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/busca"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/campo"
            android:drawableStart="@drawable/ic_busca"
            android:drawablePadding="10dp"
            android:drawableTint="@color/texto2"
            android:hint="@string/buscar"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto2"
            android:textSize="16sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="88dp" />

            <LinearLayout
                android:id="@+id/vazio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/vazioTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/nenhum"
                    android:textColor="@color/texto2"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnPermitir"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/botao"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/permitir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnAbrir"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/botao"
        android:drawableStart="@drawable/ic_pasta"
        android:drawablePadding="8dp"
        android:elevation="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:text="@string/abrir_arquivo"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

</FrameLayout>
