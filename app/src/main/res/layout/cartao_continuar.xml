<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/cartao"
    android:orientation="horizontal"
    android:padding="14dp">

    <com.leitordelivros.app.CapaView
        android:id="@+id/capaContinuar"
        android:layout_width="112dp"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/continuar_lendo"
            android:textAllCaps="true"
            android:textColor="@color/destaque"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tituloContinuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/texto"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autorContinuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/texto2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/capituloContinuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="@color/texto"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressoContinuar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/progresso" />

            <TextView
                android:id="@+id/porcentagemContinuar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/texto2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/botao"
                android:text="@string/ler"
                android:textAllCaps="false"
                android:textColor="@color/destaque_escuro"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOuvir"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/chip"
                android:drawableStart="@drawable/ic_fones"
                android:drawableTint="@color/destaque"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/ouvir"
                android:textAllCaps="false"
                android:textColor="@color/texto" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
